  "components": [
    {
      "name": "Primary Action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The next guided action; color and disabled states are presentation, not run evidence.",
      "html": "<button type=\"button\" class=\"ds-primary\">Run private read <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-5-5 5 5-5 5\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:52px;height:auto;padding:12px 26px;border:0;border-radius:999px;font-family:var(--font-text);font-size:1rem;font-weight:600;line-height:1.55;white-space:normal;text-align:center;cursor:pointer;transition:background-color .2s,box-shadow .2s,transform .2s var(--ease-out);background:var(--accent);color:var(--accent-ink);}.ds-primary:hover:not(:disabled){background:var(--accent-hover);}.ds-primary:active:not(:disabled){background:var(--accent-press);transform:scale(.98);}.ds-primary:disabled{background:var(--bg-deep);color:var(--ink-3);cursor:not-allowed;}.ds-primary:focus-visible{outline:2px solid var(--protected);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-nav a,.ds-switch,.ds-thumb,.ds-step{transition-duration:0.01ms!important;animation-duration:0.01ms!important;animation-iteration-count:1!important;}}"
    },
    {
      "name": "Secondary Action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Explicit supporting actions with an inset divider.",
      "html": "<button type=\"button\" class=\"ds-secondary\">View evidence</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:52px;height:auto;padding:12px 26px;border:0;border-radius:999px;font-family:var(--font-text);font-size:1rem;font-weight:600;line-height:1.55;white-space:normal;text-align:center;cursor:pointer;transition:background-color .2s,box-shadow .2s,transform .2s var(--ease-out);background:var(--surface);color:var(--ink);box-shadow:inset 0 0 0 1px var(--line-strong);}.ds-secondary:hover:not(:disabled){background:var(--surface-2);}.ds-secondary:active:not(:disabled){transform:scale(.98);}.ds-secondary:disabled{color:var(--ink-3);cursor:not-allowed;}.ds-secondary:focus-visible{outline:2px solid var(--protected);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-nav a,.ds-switch,.ds-thumb,.ds-step{transition-duration:0.01ms!important;animation-duration:0.01ms!important;animation-iteration-count:1!important;}}"
    },
    {
      "name": "Offline Scenario Selector",
      "kind": "input",
      "refersTo": "scenario-selector",
      "description": "The offline walkthrough’s native scenario select; no generic text-input style is inferred.",
      "html": "<span class=\"ds-select-wrap\"><select class=\"ds-select\" aria-label=\"Scenario\"><option>Worker ready</option><option>Worker unavailable</option></select><svg class=\"ds-select-arrow\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"#4b4759\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6.5 8.5 3.5 3.5 3.5-3.5\"/></svg></span>",
      "css": ".ds-select-wrap{position:relative;display:inline-flex;}.ds-select{appearance:none;min-height:44px;padding:0 38px 0 14px;border:0;border-radius:var(--radius-sm);background:var(--surface-2);box-shadow:inset 0 0 0 1px var(--line-strong);color:var(--ink);font-family:var(--font-text);font-size:.875rem;font-weight:500;line-height:1.55;cursor:pointer;}.ds-select-arrow{position:absolute;right:10px;top:50%;transform:translateY(-50%);pointer-events:none;}.ds-select:focus-visible{outline:2px solid var(--protected);outline-offset:3px;}"
    },
    {
      "name": "Section Navigation",
      "kind": "nav",
      "refersTo": "section-navigation",
      "description": "A two-link pill; the app updates aria-current from scroll position.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Sections\"><a href=\"#demo\" aria-current=\"location\">The lab</a><a href=\"#under-the-hood\">Evidence</a></nav>",
      "css": ".ds-nav{display:inline-flex;gap:2px;padding:5px;border-radius:999px;background:var(--surface);box-shadow:var(--shadow-float);}.ds-nav a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:9px 18px;border-radius:999px;color:var(--ink-2);font-family:var(--font-text);font-size:.9375rem;font-weight:500;line-height:1.55;text-decoration:none;transition:background-color .2s,color .2s;}.ds-nav a:hover{background:var(--surface-2);color:var(--ink);}.ds-nav a[aria-current=\"location\"]{background:var(--protected-soft);color:var(--ink);}.ds-nav a:focus-visible{outline:2px solid var(--protected);outline-offset:3px;}@media(max-width:899px){.ds-nav{padding:3px;box-shadow:none;}.ds-nav a{min-width:120px;padding-block:7px;}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-nav a,.ds-switch,.ds-thumb,.ds-step{transition-duration:0.01ms!important;animation-duration:0.01ms!important;animation-iteration-count:1!important;}}"
    },
    {
      "name": "Simulated Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Explicit fixture provenance with an amber dot; never a live-success badge.",
      "html": "<span class=\"ds-tag\" title=\"Fixture data. Nothing here was observed on a network.\"><span class=\"ds-dot\" aria-hidden=\"true\"></span>Simulated</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;gap:6px;min-height:26px;padding:0 10px;border-radius:999px;background:#fbf3e4;color:var(--sim);font-family:var(--font-text);font-size:.75rem;font-weight:600;line-height:1.55;white-space:normal;}.ds-dot{width:8px;height:8px;flex:none;border-radius:50%;background:var(--sim-dot);}"
    },
    {
      "name": "Evidence Card",
      "kind": "card",
      "refersTo": "card",
      "description": "White evidence surface; this static sample keeps its state explicitly untested.",
      "html": "<article class=\"ds-card\"><h3 class=\"ds-card-title\">Worker</h3><p class=\"ds-card-lead\">Not started</p><p class=\"ds-card-sub\">Untested. Run a step to collect evidence.</p></article>",
      "css": ".ds-card{min-width:0;padding:24px;border-radius:var(--radius-md);background:var(--surface);color:var(--ink);box-shadow:var(--shadow-card);font-family:var(--font-text);line-height:1.55;}.ds-card-title{margin:0 0 16px;font-family:var(--font-display);font-size:1.125rem;font-weight:600;letter-spacing:-.01em;}.ds-card-lead{margin:0;color:var(--ink-3);font-family:var(--font-display);font-size:1.5rem;font-weight:600;line-height:1.2;letter-spacing:-.02em;}.ds-card-sub{margin:4px 0 0;color:var(--ink-2);font-size:.9375rem;}@media(max-width:520px){.ds-card{padding:20px;}}"
    },
    {
      "name": "Private-mode Switch",
      "kind": "custom",
      "refersTo": "switch",
      "description": "The current on-state sample uses aria-checked and the real extended hit area.",
      "html": "<button type=\"button\" class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Private mode\"><span class=\"ds-thumb\" aria-hidden=\"true\"></span></button>",
      "css": ".ds-switch{position:relative;width:44px;height:26px;border:0;border-radius:999px;background:var(--line-strong);cursor:pointer;transition:background-color .25s var(--ease-out);}.ds-switch:before{content:\"\";position:absolute;inset:-9px 0;}.ds-thumb{position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgb(23 20 31 / .25);transition:transform .3s var(--ease-out);}.ds-switch[aria-checked=\"true\"]{background:var(--protected);}.ds-switch[aria-checked=\"true\"] .ds-thumb{transform:translateX(18px);}.ds-switch:focus-visible{outline:2px solid var(--protected);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-nav a,.ds-switch,.ds-thumb,.ds-step{transition-duration:0.01ms!important;animation-duration:0.01ms!important;animation-iteration-count:1!important;}}"
    },
    {
      "name": "Current Guide Step",
      "kind": "button",
      "refersTo": "guide-step-current",
      "description": "A current step uses white fill and a dark marker; the sample does not execute a lab action.",
      "html": "<button type=\"button\" class=\"ds-step\" aria-current=\"step\"><span class=\"ds-step-marker\">1</span>Read privately</button>",
      "css": ".ds-step{display:flex;align-items:center;gap:14px;width:100%;min-height:48px;padding:8px 12px;border:0;border-radius:var(--radius-md);background:none;color:var(--ink-2);font-family:var(--font-text);font-size:.9375rem;font-weight:500;line-height:1.55;text-align:left;cursor:pointer;transition:background-color .2s;}.ds-step:hover{background:rgb(255 255 255 / .6);}.ds-step[aria-current=\"step\"]{background:var(--surface);color:var(--ink);font-weight:600;box-shadow:var(--shadow-float);}.ds-step-marker{display:grid;place-items:center;width:26px;height:26px;flex:none;border-radius:50%;background:var(--ink);color:#fff;font-size:.8125rem;font-weight:600;}.ds-step:focus-visible{outline:2px solid var(--protected);outline-offset:3px;}@media(max-width:899px){.ds-step{align-items:flex-start;gap:10px;height:100%;font-size:.875rem;}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-nav a,.ds-switch,.ds-thumb,.ds-step{transition-duration:0.01ms!important;animation-duration:0.01ms!important;animation-iteration-count:1!important;}}"
    },
    {
      "name": "Request Route Explanation",
      "kind": "custom",
      "refersTo": "route-choice",
      "description": "Static preview of local Private/Direct explanation choices. The app buttons change explanation only; they do not send requests or change policy.",
      "html": "<div class=\"ds-route-choices\" data-route=\"private\" role=\"group\" aria-label=\"Route explanations\"><button type=\"button\" class=\"ds-route-choice\" aria-pressed=\"true\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10 2.5 4 5v4.6c0 3.7 2.6 6.6 6 7.9 3.4-1.3 6-4.2 6-7.9V5z\"/></svg>Private path</button><button type=\"button\" class=\"ds-route-choice\" aria-pressed=\"false\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2.5 10s2.8-5 7.5-5 7.5 5 7.5 5-2.8 5-7.5 5-7.5-5-7.5-5zM10 12.3a2.3 2.3 0 1 0 0-4.6 2.3 2.3 0 0 0 0 4.6z\"/></svg>Direct path</button></div>",
      "css": ".ds-route-choices{display:flex;gap:4px;width:fit-content;max-width:100%;padding:4px;border-radius:12px;background:var(--surface-2);}.ds-route-choice{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:0;border-radius:9px;background:transparent;color:var(--ink-2);font-family:var(--font-text);font-size:.875rem;font-weight:600;line-height:1.55;cursor:pointer;transition:background-color 180ms,color 180ms,box-shadow 240ms var(--ease-out);}.ds-route-choice:hover{color:var(--ink);background:var(--bg-deep);}.ds-route-choice[aria-pressed=\"true\"]{color:var(--protected);background:var(--surface);box-shadow:var(--shadow-float);}.ds-route-choices[data-route=\"direct\"] .ds-route-choice[aria-pressed=\"true\"]{color:var(--exposed);}.ds-route-choice:focus-visible{outline:2px solid var(--protected);outline-offset:3px;}@media(max-width:640px){.ds-route-choice{padding-inline:12px;}}@media(prefers-reduced-motion:reduce){.ds-route-choice{transition-duration:.01ms!important;}}"
    },
    {
      "name": "Read Inspector",
      "kind": "custom",
      "refersTo": "read-inspector",
      "description": "Native result disclosure. This preview uses clearly labelled simulated example metadata; the app displays supplied read values without raw RPC parameters.",
      "html": "<details class=\"ds-read-inspector\"><summary>Inspect read<svg class=\"ds-read-arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10 4.5v11m-4.5-4.5L10 15.5l4.5-4.5\"/></svg></summary><dl><div><dt>Method</dt><dd class=\"ds-read-mono\">eth_getBalance</dd></div><div><dt>Route</dt><dd>Example only</dd></div><div><dt>Evidence</dt><dd>SIMULATED example</dd></div><div><dt>Outcome</dt><dd>Example only</dd></div><div><dt>Round trip</dt><dd>Pending</dd></div><div><dt>Read ID</dt><dd class=\"ds-read-mono\">example-read</dd></div></dl></details>",
      "css": ".ds-read-inspector{margin-top:16px;border-top:1px solid var(--line);color:var(--ink-2);font-family:var(--font-text);font-size:.8125rem;line-height:1.55;}.ds-read-inspector summary{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:44px;list-style:none;font-weight:600;cursor:pointer;}.ds-read-inspector summary::-webkit-details-marker{display:none;}.ds-read-inspector[open] summary .ds-read-arrow{transform:rotate(180deg);}.ds-read-inspector summary:focus-visible{outline:2px solid var(--protected);outline-offset:3px;}.ds-read-inspector dl{margin:0;padding-block:4px 8px;}.ds-read-inspector dl>div{padding-block:6px;}.ds-read-inspector dt{color:var(--ink-3);font-size:.75rem;}.ds-read-inspector dd{margin:2px 0 0;overflow-wrap:anywhere;}.ds-read-mono{font-family:var(--font-mono);font-size:.9em;font-variant-numeric:tabular-nums;}"
    }
  ],
  "narrative": {
    "northStar": "The Guided Lab",
    "overview": "The current world is a clean, light interface for a lit room or projector: lavender-grey paper, white working surfaces, dark plum ink and restrained purple actions. A readable request explorer replaces the complete dark 3D card. The owner rejected both earlier stage revisions; their visual approvals do not carry forward. Keep the original Monolith mark and self-hosted typography, with no copied mascot or assets.\n\nThe explorer explains a request through local route choices, clickable stops and expandable fields. Separate run actions, worker status and comparison cards carry the actual lab state. An example is useful without pretending to be a measurement. [PRODUCT.md](PRODUCT.md) carries product truth and [the guided-lab brief](.impeccable/guided-lab.md) carries the surface flow. Tokens are extracted from [tokens.css](src/styles/tokens.css) and [lab.css](src/styles/lab.css); sidecar tonal ramps are derived preview swatches, not extra application tokens.\n\nThe default app is the live composition; `?mode=simulated` opens the offline fixture walkthrough. Mode names identify the selected mode; result badges identify run provenance. The [MN-006 review](docs/review/README.md), [first lavender review](docs/review/lavender-20261107/README.md) and [sculptural-stage review](docs/review/lavender-20261107/stage-v2/README.md) remain historical records for their named builds. The replacement is documented separately in [request-explorer/README.md](docs/review/lavender-20261107/request-explorer/README.md). Presentation screenshots and local examples establish no new live anonymity, registry, payment or sponsor evidence.",
    "keyCharacteristics": [
      "Lavender paper, white working surfaces and dark readable ink.",
      "Purple primary/private controls, red direct exposure and explicit provenance words.",
      "A light request explanation beside separate run results.",
      "Ordinary DOM controls, SVG icons, visible focus and responsive reading order."
    ],
    "rules": [
      {
        "name": "The Meaning Rule",
        "body": "Use purple for the primary action and protected route, red for direct exposure, green for a passing check, and amber for simulated data. A color or animation never grants evidence credit.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** keep dark readable ink on lavender paper and white working surfaces.",
      "**Do** preserve one clear next run action and a separate local request explanation.",
      "**Do** pair meaning colors with words, pressed states and explicit provenance.",
      "**Do** keep mobile stops vertical, native disclosures usable and focus visible.",
      "**Do** show residual payload exposure beside route protection and actual result evidence."
    ],
    "donts": [
      "**Don't** restore the rejected dark 3D card, GPU effects, parallax or moving packet scene.",
      "**Don't** make Private/Direct explanation buttons send a read or change the real privacy policy.",
      "**Don't** treat example fields, a mode label or a screenshot as observed anonymity evidence.",
      "**Don't** invent traffic, hop counts, successful reads, full coverage or privacy scores.",
      "**Don't** hide a bypass during an outage or depict payment as anonymous."
    ]
  }
}
