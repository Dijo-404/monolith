{
  "name": "@monolith/registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./source": {
      "types": "./dist/adapters/source/git-snapshot.d.ts",
      "import": "./dist/adapters/source/git-snapshot.js"
    },
    "./arkiv": {
      "types": "./dist/adapters/arkiv/writer.d.ts",
      "import": "./dist/adapters/arkiv/writer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@monolith/shared": "workspace:*",
    "@arkiv-network/sdk": "1.0.1",
    "viem": "2.57.16"
  }
}
