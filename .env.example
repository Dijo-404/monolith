# Public: this exact key is allowlisted into the dashboard bundle.
# Use an HTTP(S) origin without credentials, path, query or fragment.
MONOLITH_PUBLIC_OBSERVER_URL=http://127.0.0.1:3001

# Server only: never use a MONOLITH_PUBLIC_ prefix for keys or secrets.
MONOLITH_OBSERVER_HOST=127.0.0.1
MONOLITH_OBSERVER_PORT=3001

# Observer routing is disabled until an operator configures approved public HTTPS endpoints.
# Each endpoint has endpointId, decimal chainId, rpcUrl and an explicit calls array.
# See docs/observer.md for synthetic examples and deployment/source-policy requirements.
MONOLITH_OBSERVER_ENDPOINTS=[]

# Source evidence is inconclusive until the deployment topology is explicitly declared.
# Set direct only for a listener reached directly; trusted-proxy requires exact edge IPs.
MONOLITH_OBSERVER_SOURCE_MODE=unknown
MONOLITH_OBSERVER_TRUSTED_PROXIES=

# Register only fresh random lab-run and baseline RPC UUIDv4 identifiers.
# Ordinary RPC reads are never saved as lab observations.
MONOLITH_OBSERVER_LAB_RUNS=[]

# Set NODE_ENV on the server process when deploying, not in the shared .env:
# NODE_ENV=production pnpm start:observer

# No signing keys are needed for the observer.
# Future importer/relayer secrets must stay server-side and out of public config.
